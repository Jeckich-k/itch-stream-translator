{
  "manifest_version": 3,
  "name": "Live Chat Translator (Twitch & YouTube)",
  "version": "1.1",
  "description": "Автоматический перевод сообщений чата Twitch и YouTube (включая перевод с корейского на русский).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
