{
    "manifest_version": 3,
    "name": "Live Chat & Speech Translator (Twitch & YouTube)",
    "version": "1.5",
    "description": "Автоматический перевод чата и экранных субтитров Twitch и YouTube в реальном времени (корейский ➔ русский и др.).",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://translate.googleapis.com/*",
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.twitch.tv/*",
        "*://twitch.tv/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://youtube.com/*",
                "*://*.twitch.tv/*",
                "*://twitch.tv/*"
            ],
            "all_frames": true,
            "js": ["scripts/content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "ui/index.html",
        "default_title": "Chat & Speech Translator",
        "default_icon": "icons/icon.png"
    },
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "background": {
        "service_worker": "scripts/background.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "resources": ["locales/*"],
            "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.twitch.tv/*", "*://twitch.tv/*"]
        }
    ]
}
